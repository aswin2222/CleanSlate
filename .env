STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=209715200
MAX_COLUMNS=2000
MAX_FIELD_LENGTH=100000
MAX_HEADER_LENGTH=1000
MAX_PARSE_TIME_SECONDS=60
ZIP_MAX_EXPANSION_RATIO=100
ZIP_MAX_UNCOMPRESSED_BYTES=524288000
IN_MEMORY_MAX_ROWS=2000000
MIN_ROWS_FOR_INFERENCE=30
SPARSE_THRESHOLD=0.90
IMPUTE_MAX_NULL_RATE=0.30
