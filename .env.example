# ==============================================================================
# CleanSlate Environment Configuration
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Secrets
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=X8v2U7nF3qT9zY1wK5pL8rJ2mD6sA4eH7bV1cN9gP3s=
JWT_SECRET_KEY=cleanslate-super-secret-jwt-key-replace-in-production-min32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite (default development):
DATABASE_URL=sqlite:///./cleanslate.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://cleanslate:cleanslate_secret@localhost:5432/cleanslatedb

# Redis Cache (optional with transparent in-memory fallback)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (none | openai_compatible)
# Preset 1: Disabled / Heuristic Mode (default, fully deterministic)
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=heuristic
LLM_TIMEOUT_S=15

# Preset 2: Local Ollama (zero-cost, private)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3:8b
# LLM_TIMEOUT_S=30

# Preset 3: Google Gemini (OpenAI-compatible endpoint)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-1.5-flash
# LLM_TIMEOUT_S=20

# Preset 4: OpenAI
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-openai-api-key
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_S=20

# Storage & Ingestion Guardrails
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=209715200          # 200 MB
MAX_COLUMNS=2000
MAX_FIELD_LENGTH=100000
MAX_HEADER_LENGTH=1000
MAX_PARSE_TIME_SECONDS=60
ZIP_MAX_EXPANSION_RATIO=100
ZIP_MAX_UNCOMPRESSED_BYTES=524288000 # 500 MB
IN_MEMORY_MAX_ROWS=2000000
MIN_ROWS_FOR_INFERENCE=30
SPARSE_THRESHOLD=0.90
IMPUTE_MAX_NULL_RATE=0.30
